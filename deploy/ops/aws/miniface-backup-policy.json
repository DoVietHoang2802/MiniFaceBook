{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyMiniFaceBackupPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::YOUR_PRIVATE_BACKUP_BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["miniface/mongodb/*"]
        }
      }
    },
    {
      "Sid": "ReadWriteMiniFaceBackups",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::YOUR_PRIVATE_BACKUP_BUCKET/miniface/mongodb/*"
    }
  ]
}
