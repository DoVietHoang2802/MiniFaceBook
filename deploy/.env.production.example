# Copy to deploy/.env.production on AWS. Never commit the real file.
MONGODB_URI=mongodb+srv://miniface_app:URL_ENCODED_PASSWORD@CLUSTER_URL/miniface_db?retryWrites=true&w=majority
REDIS_PASSWORD=GENERATE_A_LONG_RANDOM_REDIS_PASSWORD
JWT_SECRET=GENERATE_A_LONG_RANDOM_JWT_SECRET
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_PRODUCTION_API_KEY
CLOUDINARY_API_SECRET=YOUR_PRODUCTION_API_SECRET
GOOGLE_CLIENT_ID=YOUR_PRODUCTION_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_PRODUCTION_GOOGLE_CLIENT_SECRET
GOOGLE_OAUTH_ENABLED=true
APP_FRONTEND_URL=https://www.YOUR_DOMAIN
APP_API_URL=https://api.YOUR_DOMAIN/api
CORS_ALLOWED_ORIGINS=https://YOUR_DOMAIN,https://www.YOUR_DOMAIN
RESEND_API_KEY=re_YOUR_PRODUCTION_KEY
RESEND_FROM_EMAIL=noreply@YOUR_DOMAIN
RESEND_FROM_NAME=MiniFaceBook
SENTRY_DSN=YOUR_SENTRY_DSN
SENTRY_TRACES_SAMPLE_RATE=0.1
RATE_LIMIT_CAPACITY=1000
